@{
    ViewData["Title"] = "Page Not Found";
}

@section Styles {
    <style>
        .not-found-page {
            min-height: 65vh;
            display: flex;
            align-items: center;
        }

        .not-found-card {
            max-width: 680px;
            background: linear-gradient(145deg, rgba(33, 37, 41, .98), rgba(52, 58, 64, .96));
        }

        .not-found-icon {
            width: 88px;
            height: 88px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(220, 53, 69, .35);
            background-color: rgba(220, 53, 69, .12);
        }
    </style>
}

<div class="not-found-page justify-content-center py-5">
    <div class="not-found-card card border-0 shadow-lg rounded-4 text-light text-center">
        <div class="card-body p-4 p-md-5">
            <div class="not-found-icon rounded-circle mx-auto mb-4 text-danger" aria-hidden="true">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>

            <h3 class="text-danger text-uppercase fw-bold mb-2">Error 404</h3>
            
            <p class="lead text-light mb-4">
                We couldn’t find the page or movie you were looking for. It may have moved or no longer be available.    
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-danger rounded-pill px-4 fw-bold">
                    <i class="bi bi-house-door-fill me-1"></i> Back to Home
                </a>
                <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 fw-bold">
                    <i class="bi bi-film me-1"></i> Browse Movies
                </a>
            </div>
        </div>
    </div>
</div>
