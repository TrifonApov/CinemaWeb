@model MoviesAllIndexViewModel

@{
    ViewData["Title"] = "All Movies";
    int endPageIndex = int.Min((Model.StartPageIndex + Model.ShowingPages - 1), Model.TotalPages);
}

@section Styles {
    <link rel="stylesheet" href="~/css/user.css">
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-light fw-bold">Explore Movies</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-bold">
            <i class="bi bi-arrow-left"></i> Back to Home Page
        </a>
    </div>

    <div class="d-flex flex-column gap-2">
        <!-- Search Form -->
        <div>
            <form asp-controller="Movie" asp-action="Index" method="get" class="mb-4">
                <div class="input-group">
                    <input asp-for="SearchQuery"
                           type="text"
                           name="searchQuery"
                           class="form-control"
                           placeholder="Search by title..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty) ">
                        <a asp-area="" asp-controller="Movie" asp-action="Index"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           class="page-link">Previous</a>
                    </li>
                    @for (int i = Model.StartPageIndex; i <= endPageIndex && i <= Model.TotalPages; i++)
                    {
                        if (i > 0)
                        {
                            <li class="page-item @(@Model.PageNumber == i ? "active" : string.Empty)">
                                <a class="page-link"
                                   asp-area="" asp-controller="Movie" asp-action="Index"
                                   asp-route-searchQuery="@Model.SearchQuery"
                                   asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty) ">
                        <a asp-area="" asp-controller="Movie" asp-action="Index"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           class="page-link">Next</a>
                    </li>
                </ul>
            </nav>
        </div>

        @if (!Model.Movies.Any())
        {
            if (Model.SearchQuery != null)
            {
                <h3 class="text-warning">There are no movies matching your search "@Model.SearchQuery".</h3>
            }
            else
            {
                <h3 class="text-warning">There is no movie to show</h3>
            }
        }

        @foreach (MoviesIndexViewModel movie in Model.Movies)
        {
            <div class="card shadow-lg border-0 rounded-3 d-flex flex-row align-items-center p-2"
                 style="height: 140px; max-height: 140px;">
                <img src="@movie.ImageUrl" class="rounded"
                     alt="@movie.Title"
                     style="width: 100px; height: 130px; object-fit: cover;">
                <div class="card-body ms-3 p-2 text-light" style="flex-grow: 1;">
                    <h6 class="fw-bold mb-1 text-dark">@movie.Title</h6>
                    <p class="text-muted mb-0" style="font-size: 0.85rem;">
                        <strong>Genre:</strong> @movie.Genre |
                        <strong>Director:</strong> @movie.Director
                    </p>
                    <p class="text-muted mb-1" style="font-size: 0.85rem;">
                        <strong>Released:</strong> @movie.ReleaseDate
                    </p>
                </div>
                <div class="me-3 d-flex gap-2">
                    <a asp-area=""
                       asp-controller="Movie"
                       asp-action="Details"
                       asp-route-id="@movie.Id"
                       class="bnt btn-primary btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-eye"></i>View Details
                    </a>
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        if (movie.IsInUserWatchlist)
                        {
                            <div class="btn btn-outline-success btn-sm rounded-pill px-3 add-to-watchlist-btn"
                                 data-movie-id="@movie.Id">
                                <i class="fas fa-bookmark"></i> Already in your watchlist
                            </div>
                        }
                        else
                        {
                            <a asp-area=""
                               asp-controller="Watchlist"
                               asp-action="AddToWatchlist"
                               asp-route-id="@movie.Id"
                               class="btn btn-outline-warning btn-sm rounded-pill px-3 add-to-watchlist-btn">
                                <i class="bi bi-bookmark"></i> Add to Watchlist
                            </a>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>



